{
  "name": "@talarurus/pibulo",
  "version": "0.3.2",
  "description": "An open-source toolkit for expressive AI-agent identities, activity visualization, deterministic replay and motion export.",
  "private": true,
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/talarurus/pibulo.git"
  },
  "engines": {
    "node": ">=24.21.0 <25"
  },
  "packageManager": "npm@11.19.0",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.js"
    },
    "./motion.css": "./dist/motion.css",
    "./gaze.css": "./dist/gaze.css",
    "./react.css": "./dist/react.css",
    "./activity": {
      "types": "./dist/types/src/activity.d.ts",
      "import": "./dist/activity.js"
    },
    "./activity/react": {
      "types": "./dist/types/src/activity-react.d.ts",
      "import": "./dist/activity-react.js"
    },
    "./scenes": {
      "types": "./dist/types/src/scenes.d.ts",
      "import": "./dist/scenes.js"
    },
    "./scenes.css": "./dist/scenes.css",
    "./recording": {
      "types": "./dist/types/src/recording.d.ts",
      "import": "./dist/recording.js"
    },
    "./motion": {
      "types": "./dist/types/src/motion.d.ts",
      "import": "./dist/motion.js"
    },
    "./motion/react": {
      "types": "./dist/types/src/motion-react.d.ts",
      "import": "./dist/motion-react.js"
    },
    "./export/mp4": {
      "types": "./dist/types/src/mp4.d.ts",
      "import": "./dist/mp4.js"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "THIRD-PARTY-NOTICES.txt",
    "README.md",
    "docs/api.md",
    "docs/motion-api.md",
    "docs/mp4-export.md",
    "docs/mp4-frame-contract.md",
    "docs/migration-pibulo.md",
    "docs/releases/v0.3.2.md",
    "assets/pibulo-rebrand/home-1440.png",
    "assets/pibulo-rebrand/home-390.png",
    "assets/whoami-activity-poster.png",
    "assets/whoami-activity-demo.recording.json"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "peerDependencies": {
    "react": "^19.2.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "start": "node website/preview/dev.mjs",
    "test": "node --test website/preview/tests/*.test.mjs tests/*.test.mjs",
    "typecheck": "tsc -p tsconfig.production.json --noEmit && tsc -p tsconfig.website.json && tsc -p tsconfig.json",
    "test:browser": "node website/preview/tests/browser.mjs && node website/preview/tests/polish-browser.mjs && node website/preview/tests/refinement-browser.mjs",
    "check:release": "node scripts/check-release.mjs",
    "example:react": "node examples/react/dev.mjs",
    "test:consumer": "node scripts/check-consumer.mjs",
    "test:studio": "node website/preview/tests/studio-browser.mjs",
    "test:motion:browser": "node website/preview/tests/motion-browser.mjs",
    "test:mp4:browser": "node website/preview/tests/mp4-browser.mjs"
  },
  "devDependencies": {
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "esbuild": "0.25.11",
    "mp4-muxer": "5.2.2",
    "playwright": "1.62.1",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "typescript": "5.9.3"
  }
}
